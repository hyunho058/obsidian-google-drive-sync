{
  "name": "obsidian-gdrive-vault-sync",
  "version": "0.1.2",
  "description": "Two-way sync between an Obsidian vault and Google Drive using your own Google credentials. Desktop + iOS.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "node tests/run.mjs",
    "check": "tsc --noEmit --skipLibCheck && node tests/run.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/spark-md5": "^3.0.5",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.7.2",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "spark-md5": "^3.0.2"
  }
}
